# Copie este arquivo para .env.local e preencha com os valores reais do seu
# projeto Supabase. NUNCA faça commit do arquivo .env.local (já está no
# .gitignore) nem preencha valores reais aqui neste .env.example.

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase (Project Settings > API)
# Segura para expor no navegador — o acesso aos dados é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" do Supabase — USO EXCLUSIVO NO SERVIDOR.
# Ignora o RLS. Nunca prefixar com NEXT_PUBLIC_ e nunca expor ao navegador.
# Só será necessária em rotas server-side específicas (ex.: jobs administrativos).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada em metadados, links de e-mail do Supabase Auth etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Timezone padrão do app (datas exibidas em pt-BR, armazenadas com timezone)
NEXT_PUBLIC_TIMEZONE=America/Sao_Paulo
